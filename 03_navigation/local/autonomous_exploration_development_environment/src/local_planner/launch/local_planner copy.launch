<launch>
  <arg name="odomTopic" default="/lio/odom"/>
  <arg name="registeredScanTopic" default="/lio/cloud_world"/>
  <!-- Go2W URDF imu_joint: base -> imu x=-0.02557 m. /lio/odom is at the IMU;
       localPlanner computes vehicle = odom - R(yaw) * sensorOffset. -->
  <arg name="sensorOffsetX" default="-0.02557"/>
  <arg name="sensorOffsetY" default="0"/>
  <arg name="cameraOffsetZ" default="0"/>
  <arg name="publishSensorTf" default="false"/>
  <arg name="publishCameraTf" default="false"/>
  <arg name="twoWayDrive" default="false"/> 
  <arg name="maxSpeed" default="0.8"/>
  <arg name="autonomyMode" default="true"/>
  <arg name="autonomySpeed" default="0.8"/>
  <arg name="joyToSpeedDelay" default="2.0"/>
  <arg name="goalX" default="0"/>
  <arg name="goalY" default="0"/>
  <node pkg="local_planner" type="localPlanner" name="localPlanner" output="screen" required="true">
    <remap from="/state_estimation" to="$(arg odomTopic)"/>
    <remap from="/registered_scan" to="$(arg registeredScanTopic)"/>
    <param name="pathFolder" type="string" value="$(find local_planner)/paths" />
    <!-- Measured Go2W standing footprint: 0.69 x 0.42 m; allow 0.05 m per side. -->
    <param name="vehicleLength" type="double" value="0.79" />
    <param name="vehicleWidth" type="double" value="0.52" />
    <param name="sensorOffsetX" value="$(arg sensorOffsetX)" />
    <param name="sensorOffsetY" value="$(arg sensorOffsetY)" />
    <param name="twoWayDrive" value="$(arg twoWayDrive)" />
    <param name="laserVoxelSize" type="double" value="0.15" />
    <param name="terrainVoxelSize" type="double" value="0.15" />
    <param name="useTerrainAnalysis" type="bool" value="false" />
    <param name="checkObstacle" type="bool" value="true" />
    <param name="checkRotObstacle" type="bool" value="true" />
    <!-- 控制是否检测在机器人半径范围内的点云导致的碰撞，比如机器人本体携带的一些物体 -->
    <param name="adjacentRange" type="double" value="4" />
    <param name="obstacleHeightThre" type="double" value="0.2" />
    <param name="groundHeightThre" type="double" value="0.05" />
    <param name="costHeightThre" type="double" value="0.1" />
    <param name="costScore" type="double" value="0.02" />
    <param name="useCost" type="bool" value="false" />
    <param name="pointPerPathThre" type="int" value="2" />
    <!-- With the current LI-Init extrinsic, the measured floor is near -0.55 m
         relative to /lio/odom. Exclude floor returns while retaining taller obstacles. -->
    <param name="minRelZ" type="double" value="-0.45" />
    <param name="maxRelZ" type="double" value="0.35" />
    <!-- Measured front-right wheel self-return in vehicle coordinates. -->
    <param name="selfFilterEnabled" type="bool" value="true" />
    <param name="selfFilterMinX" type="double" value="0.38" />
    <param name="selfFilterMaxX" type="double" value="0.44" />
    <param name="selfFilterMinY" type="double" value="-0.24" />
    <param name="selfFilterMaxY" type="double" value="-0.17" />
    <param name="selfFilterMinZ" type="double" value="-0.42" />
    <param name="selfFilterMaxZ" type="double" value="-0.28" />
    <param name="maxSpeed" value="$(arg maxSpeed)" />
    <param name="dirWeight" type="double" value="0.02" />
    <param name="dirThre" type="double" value="60.0" />
    <!-- 判断是否要原地转向,目标点超过阈值就要原地转向了 -->
    <param name="dirToVehicle" type="bool" value="false" />
    <param name="pathScale" type="double" value="2" />
    <param name="minPathScale" type="double" value="0.5" />
    <param name="pathScaleStep" type="double" value="0.25" />
    <param name="pathScaleBySpeed" type="bool" value="true" />
    <param name="minPathRange" type="double" value="0.5" />
    <!-- 修改 最小路径尺度-->
    <param name="pathRangeStep" type="double" value="0.4" />
    <param name="pathRangeBySpeed" type="bool" value="true" />
    <param name="pathCropByGoal" type="bool" value="true" />
    <!-- 用于控制路径的范围 false可以去未知区域 -->
    <param name="autonomyMode" value="$(arg autonomyMode)" />
    <param name="autonomySpeed" value="$(arg autonomySpeed)" />
    <param name="joyToSpeedDelay" value="$(arg joyToSpeedDelay)" />
    <param name="joyToCheckObstacleDelay" type="double" value="5.0" />
    <param name="goalClearRange" type="double" value="0.8" />
    <param name="goalX" type="double" value="$(arg goalX)" />
    <param name="goalY" type="double" value="$(arg goalY)" />
  </node>
  <node pkg="local_planner" type="pathFollower" name="pathFollower" output="screen" required="true">
    <remap from="/state_estimation" to="$(arg odomTopic)"/>
    <param name="requireFarGoal" type="bool" value="true" />
    <param name="sensorOffsetX" value="$(arg sensorOffsetX)" />
    <param name="sensorOffsetY" value="$(arg sensorOffsetY)" />
    <param name="pubSkipNum" type="int" value="2" />
    <param name="twoWayDrive" value="$(arg twoWayDrive)" />
    <!-- <param name="lookAheadDis" type="double" value="0.6" /> -->
    <param name="lookAheadDis" type="double" value="0.9" />
    <param name="yawRateGain" type="double" value="2" />
    <param name="stopYawRateGain" type="double" value="2" />
    <param name="yawDeadbandDeg" type="double" value="3.0" />
    <param name="yawRateFilterTau" type="double" value="0.25" />
    <param name="maxYawRate" type="double" value="20.0" />  
  <!-- maxyawrate是限制转向速度 -->
    <param name="maxSpeed" value="$(arg maxSpeed)" />
    <param name="maxAccel" type="double" value="0.25" />
    <param name="switchTimeThre" type="double" value="3.0" />
    <param name="dirDiffThre" type="double" value="0.2" />
    <param name="stopDisThre" type="double" value="0.2" />
    <param name="slowDwnDisThre" type="double" value="1.0" />
    <!-- 到目标点之前开始减速的距离，防止冲过目标 -->
    <param name="useInclRateToSlow" type="bool" value="false" />
    <param name="inclRateThre" type="double" value="120.0" />
    <param name="slowRate1" type="double" value="0.25" />
    <param name="slowRate2" type="double" value="0.5" />
    <param name="slowTime1" type="double" value="2.0" />
    <param name="slowTime2" type="double" value="2.0" />
    <param name="useInclToStop" type="bool" value="false" />
    <!-- <param name="inclThre" type="double" value="45.0" /> -->
     <param name="inclThre" type="double" value="60.0" />
    <param name="stopTime" type="double" value="5.0" />
    <param name="noRotAtStop" type="bool" value="false" />
    <param name="noRotAtGoal" type="bool" value="true" />
    <param name="autonomyMode" value="$(arg autonomyMode)" />
    <param name="autonomySpeed" value="$(arg autonomySpeed)" />
    <param name="joyToSpeedDelay" value="$(arg joyToSpeedDelay)" />
  </node>
  <node if="$(arg publishSensorTf)" pkg="tf" type="static_transform_publisher" name="vehicleTransPublisher" args="-$(arg sensorOffsetX) -$(arg sensorOffsetY) 0 0 0 0 /sensor /vehicle 1000"/>
  <node if="$(arg publishCameraTf)" pkg="tf" type="static_transform_publisher" name="sensorTransPublisher" args="0 0 $(arg cameraOffsetZ) -1.5707963 0 -1.5707963 /sensor /camera 1000"/>
</launch>
